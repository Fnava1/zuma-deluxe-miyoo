#!/bin/sh
# Standalone Ports Script for Zuma Deluxe (OnionOS)

GameName="Zuma Deluxe"
GameDir="Zuma Deluxe"
GameExecutable="launch.sh"
GameDataFile="main.pak"
KillAudioserver=1
PerformanceMode=0
Arguments=""

unset LD_PRELOAD

PORTDIR="$(dirname "$0")"

# Search for the game directory dynamically
if [ -d "$PORTDIR/Games/Zuma Deluxe" ]; then
    GAMEDIR="$PORTDIR/Games/Zuma Deluxe"
elif [ -d "$PORTDIR/../../Games/Zuma Deluxe" ]; then
    GAMEDIR="$PORTDIR/../../Games/Zuma Deluxe"
elif [ -d "$PORTDIR/../Games/Zuma Deluxe" ]; then
    GAMEDIR="$PORTDIR/../Games/Zuma Deluxe"
elif [ -d "$PORTDIR/../../Roms/PORTS/Games/Zuma Deluxe" ]; then
    GAMEDIR="$PORTDIR/../../Roms/PORTS/Games/Zuma Deluxe"
elif [ -d "$PORTDIR/../../ROMS/PORTS/Games/Zuma Deluxe" ]; then
    GAMEDIR="$PORTDIR/../../ROMS/PORTS/Games/Zuma Deluxe"
elif [ -d "/mnt/SDCARD/Roms/PORTS/Games/Zuma Deluxe" ]; then
    GAMEDIR="/mnt/SDCARD/Roms/PORTS/Games/Zuma Deluxe"
elif [ -d "/mnt/SDCARD/ROMS/PORTS/Games/Zuma Deluxe" ]; then
    GAMEDIR="/mnt/SDCARD/ROMS/PORTS/Games/Zuma Deluxe"
else
    GAMEDIR="/mnt/SDCARD/Roms/PORTS/Games/Zuma Deluxe"
fi

if [ -f "/mnt/SDCARD/Emu/PORTS/launch_standalone.sh" ]; then
    /mnt/SDCARD/Emu/PORTS/launch_standalone.sh "$GameName" "$GameDir" "$GameExecutable" "$Arguments" "$GameDataFile" "$KillAudioserver" "$PerformanceMode"
else
    cd "$GAMEDIR"
    if [ -f "./launch.sh" ]; then
        ./launch.sh
    elif [ -f "./launcher.sh" ]; then
        ./launcher.sh
    else
        ./Zuma
    fi
fi
